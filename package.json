{
  "name": "google-classroom-student-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server that lets Claude, ChatGPT and other AI apps see your Google Classroom courses, coursework and announcements.",
  "type": "module",
  "main": "build/src/index.js",
  "bin": { "google-classroom-student-mcp": "build/src/index.js" },
  "files": ["build/src", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/src/index.js', 0o755)\"",
    "test": "vitest run",
    "start": "node build/src/index.js"
  },
  "keywords": ["mcp", "model-context-protocol", "google-classroom"],
  "author": "AnonymousOnyx22",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/AnonymousOnyx22/google-classroom-student-mcp.git" },
  "homepage": "https://brightspacemcp.com",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
